---
/** The home page's table of contents: big rows that open a photo along the slash on hover. */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { pages } from '../data/site';
import { photos } from '../data/photos';

interface Props {
	num?: string;
	/** Hide the page you're already on. */
	exclude?: string;
}

const { num = '05', exclude } = Astro.props;
const list = pages.filter((p) => p.href !== exclude);
---

<section class="ex theme-ink" aria-labelledby="ex-title">
	<div class="wrap">
		<header class="ex__head">
			<p class="eyebrow ex__eyebrow" data-reveal="fade"><span>({num})</span> Keep exploring</p>
			<h2 class="ex__title" id="ex-title" data-reveal="lines">There's more on the table.</h2>
		</header>

		<ol class="ex__list">
			{
				list.map((page, i) => {
					const photo = photos[page.photo];
					return (
						<li class="ex__item" data-reveal="fade">
							<a href={page.href} class="ex__link" data-cursor="Open">
								<span class="ex__num mono">0{i + 1}</span>
								<span class="ex__label serif">{page.label}</span>
								<span class="ex__blurb">{page.blurb}</span>
								<span class="ex__img" aria-hidden="true">
									<Image quality={70}
										src={photo.src}
										alt=""
										width={520}
										height={340}
										widths={[260, 520]}
										sizes="(max-width: 860px) 30vw, 22vw"
										fit="cover"
										style={`object-position:${photo.focus}`}
									/>
								</span>
								<Icon name="arrow" class="ex__arrow" />
							</a>
						</li>
					);
				})
			}
		</ol>
	</div>
</section>

<style>
	.ex {
		padding-block: clamp(96px, 12vw, 180px);
	}

	.ex__head {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 24px;
		margin-bottom: clamp(48px, 6vw, 88px);
	}

	.ex__eyebrow {
		grid-column: 1 / span 3;
		color: var(--timber-2);
		padding-top: 0.6em;
	}

	.ex__title {
		grid-column: 4 / -1;
		font-size: var(--step-4);
		max-width: 12ch;
	}

	.ex__list {
		border-top: 1px solid var(--line);
		counter-reset: ex;
	}

	.ex__item {
		border-bottom: 1px solid var(--line);
	}

	.ex__link {
		position: relative;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		align-items: center;
		gap: 24px;
		padding-block: clamp(22px, 2.6vw, 40px);
		isolation: isolate;
	}

	/* A timber band sweeps across the row along the slash. */
	.ex__link::before {
		content: '';
		position: absolute;
		inset: 0 calc(var(--gutter) * -1);
		z-index: -1;
		background: var(--timber-2);
		clip-path: polygon(0 0, 0 0, -20% 100%, -20% 100%);
		transition: clip-path 0.8s var(--ease-out);
	}

	.ex__link:hover::before,
	.ex__link:focus-visible::before {
		clip-path: polygon(0 0, 120% 0, 100% 100%, -20% 100%);
	}

	.ex__link:hover,
	.ex__link:focus-visible {
		color: var(--ink);
	}

	.ex__num {
		grid-column: 1 / span 1;
		font-size: var(--step--1);
		opacity: 0.6;
	}

	.ex__label {
		grid-column: 2 / span 5;
		font-size: clamp(2.8rem, 1rem + 6.4vw, 8.5rem);
		line-height: 0.9;
		letter-spacing: -0.035em;
		transition: transform 0.8s var(--ease-out), font-style 0s;
	}

	.ex__link:hover .ex__label {
		transform: translateX(0.18em);
		font-style: italic;
	}

	.ex__blurb {
		grid-column: 8 / span 4;
		max-width: 30ch;
		color: color-mix(in oklab, currentColor 72%, transparent);
	}

	.ex__arrow {
		grid-column: 12;
		justify-self: end;
		width: clamp(28px, 3vw, 48px);
		height: clamp(28px, 3vw, 48px);
		stroke-width: 1.2;
		transition: transform 0.6s var(--ease-out);
	}

	.ex__link:hover .ex__arrow {
		transform: rotate(45deg);
	}

	/* The photo opens along the slash in the middle of the row. */
	.ex__img {
		position: absolute;
		left: 46%;
		top: 50%;
		width: clamp(180px, 20vw, 340px);
		aspect-ratio: 26 / 17;
		border-radius: 14px;
		overflow: hidden;
		pointer-events: none;
		translate: -50% -50%;
		rotate: -4deg;
		clip-path: polygon(50% 0, 50% 0, 50% 100%, 50% 100%);
		transition: clip-path 0.7s var(--ease-out), rotate 0.9s var(--ease-out);
		z-index: 2;
	}

	.ex__img :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		scale: 1.25;
		transition: scale 1s var(--ease-out);
	}

	.ex__link:hover .ex__img {
		clip-path: polygon(14% 0, 100% 0, 86% 100%, 0 100%);
		rotate: 3deg;
	}

	.ex__link:hover .ex__img :global(img) {
		scale: 1;
	}

	@media (max-width: 860px) {
		.ex__eyebrow,
		.ex__title {
			grid-column: 1 / -1;
		}

		.ex__link {
			grid-template-columns: auto 1fr auto;
			gap: 6px 16px;
		}

		.ex__num {
			grid-column: 1;
			grid-row: 1;
			align-self: start;
			padding-top: 0.5em;
		}

		.ex__label {
			grid-column: 2;
			grid-row: 1;
		}

		.ex__blurb {
			grid-column: 2;
			grid-row: 2;
			font-size: 0.95rem;
		}

		.ex__arrow {
			grid-column: 3;
			grid-row: 1 / span 2;
		}

		/* On touch there is no hover: show a small thumbnail instead. */
		.ex__img {
			position: static;
			grid-column: 3;
			grid-row: 1 / span 2;
			width: 84px;
			translate: none;
			rotate: 0deg;
			clip-path: polygon(14% 0, 100% 0, 86% 100%, 0 100%);
		}

		.ex__img :global(img) {
			scale: 1;
		}

		.ex__arrow {
			display: none;
		}
	}
</style>
