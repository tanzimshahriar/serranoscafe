---
/**
 * The opening of every inner page. A huge headline with a photo pill set into it,
 * then a full-bleed plate whose top edge is cut along the logo's slash.
 * The intro is pure CSS and starts with the text half-risen, so it paints straight away.
 */
import { Image, Picture } from 'astro:assets';
import { photos, type PhotoKey } from '../data/photos';

interface Props {
	num: string;
	label: string;
	lines: [string, string];
	lede: string;
	photo: PhotoKey;
	pill: PhotoKey;
}

const { num, label, lines, lede, photo, pill } = Astro.props;
const plate = photos[photo];
const pillPhoto = photos[pill];
---

<section class="ph" data-page-hero aria-labelledby="ph-title">
	<div class="wrap ph__inner">
		<div class="ph__meta mono">
			<nav aria-label="Breadcrumb">
				<ol class="ph__crumbs">
					<li><a href="/">Home</a></li>
					<li aria-current="page">{label}</li>
				</ol>
			</nav>
			<span class="ph__num">({num})</span>
			<span class="ph__status" aria-live="polite">
				<span class="dot" data-open-dot></span>
				<span data-open-label>Tarneit Gardens</span>
			</span>
		</div>

		<h1 class="ph__title" id="ph-title">
			<span class="ph__line"><span style="--i:0">{lines[0]}</span></span>
			<span class="ph__line ph__line--2">
				<span style="--i:1">
					<span class="ph__pill" aria-hidden="true">
						<Image quality={70}
							src={pillPhoto.src}
							alt=""
							width={360}
							height={200}
							widths={[180, 360]}
							sizes="(max-width: 860px) 24vw, 14vw"
							fit="cover"
							loading="eager"
							style={`object-position:${pillPhoto.focus}`}
						/>
					</span>{lines[1]}
				</span>
			</span>
		</h1>

		<div class="ph__foot">
			<p class="ph__lede">{lede}</p>
			<div class="ph__slot"><slot /></div>
		</div>
	</div>

	<div class="ph__plate" data-parallax>
		<Picture fallbackFormat="webp"
			src={plate.src}
			alt={plate.alt}
			formats={['avif', 'webp']}
			widths={[640, 960, 1440, 1920]}
			sizes="100vw"
			fit="cover"
			loading="eager"
			fetchpriority="high"
			style={`object-position:${plate.focus}`}
		/>
	</div>
</section>

<style>
	.ph {
		position: relative;
		padding-top: clamp(120px, 15vw, 190px);
		overflow: clip;
	}

	.ph__meta {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 16px;
		padding-bottom: 18px;
		border-bottom: 1px solid var(--line);
		font-size: var(--step--1);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.ph__crumbs {
		display: flex;
		gap: 0.6em;
	}

	.ph__crumbs li + li::before {
		content: '/';
		margin-right: 0.6em;
		color: var(--timber-text);
	}

	.ph__crumbs a {
		color: var(--muted);
		transition: color 0.3s;
	}

	.ph__crumbs a:hover {
		color: var(--fg);
	}

	.ph__num {
		color: var(--timber-text);
	}

	.ph__status {
		justify-self: end;
		display: inline-flex;
		align-items: center;
		gap: 10px;
	}

	.ph__title {
		display: flex;
		flex-direction: column;
		margin-top: clamp(28px, 4vw, 56px);
		font-size: clamp(2.9rem, 0.6rem + 9.4vw, 13rem);
		line-height: 0.86;
		letter-spacing: -0.045em;
	}

	.ph__line {
		display: block;
		overflow: clip;
		padding-bottom: 0.08em;
		margin-bottom: -0.08em;
	}

	.ph__line > span {
		display: inline-flex;
		align-items: center;
		gap: 0.12em;
		animation: ph-rise 1.15s var(--ease-out) both;
		animation-delay: calc(var(--i) * 90ms + 60ms);
	}

	.ph__line--2 {
		text-align: right;
		color: var(--timber-text);
		font-style: italic;
	}

	.ph__pill {
		display: inline-block;
		width: 1.55em;
		height: 0.78em;
		border-radius: 999px;
		overflow: hidden;
		transform: rotate(calc(var(--slash) * -0.3));
		animation: ph-pill 1.4s var(--ease-out) 0.25s both;
		flex: none;
	}

	.ph__pill img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 480px) {
		.ph__pill {
			display: none;
		}
	}

	@keyframes ph-rise {
		from {
			transform: translateY(48%);
		}
	}

	@keyframes ph-pill {
		from {
			width: 0;
			opacity: 0;
		}
	}

	.ph__foot {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 24px 48px;
		margin-top: clamp(32px, 4.5vw, 64px);
		animation: ph-fade 1s var(--ease-out) 0.35s both;
	}

	.ph__lede {
		max-width: 38ch;
		font-size: var(--step-1);
		line-height: 1.35;
	}

	.ph__slot {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.ph__slot:empty {
		display: none;
	}

	@keyframes ph-fade {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
	}

	.ph__plate {
		position: relative;
		height: clamp(320px, 72svh, 860px);
		margin-top: clamp(48px, 7vw, 110px);
		overflow: hidden;
		/* Top edge cut on the slash: the left side starts lower. */
		clip-path: polygon(0 18%, 100% 0, 100% 100%, 0 100%);
		animation: ph-plate 1.5s var(--ease-io) 0.15s both;
	}

	.ph__plate :global(picture),
	.ph__plate :global(img) {
		width: 100%;
		height: 116%;
		margin-top: -8%;
		object-fit: cover;
	}

	@keyframes ph-plate {
		from {
			clip-path: polygon(0 100%, 100% 82%, 100% 100%, 0 100%);
		}
	}

	@media (max-width: 860px) {
		.ph__meta {
			grid-template-columns: 1fr auto;
		}

		.ph__num {
			display: none;
		}

		.ph__line--2 {
			text-align: left;
		}

		.ph__pill {
			width: 1.2em;
			height: 0.62em;
		}

		.ph__foot {
			grid-template-columns: 1fr;
		}

		.ph__plate {
			clip-path: polygon(0 10%, 100% 0, 100% 100%, 0 100%);
		}
	}
</style>
