---
/** The round cup stamp from their smoothie cans, with a slow-turning ring of text around it. */
interface Props {
	class?: string;
	text?: string;
}

const { class: className, text = "serranos cafe · 100% halal · tarneit gardens · " } = Astro.props;
const id = `badge-ring-${Math.random().toString(36).slice(2, 8)}`;
---

<span class:list={['badge', className]} aria-hidden="true">
	<svg viewBox="0 0 200 200" class="badge__ring">
		<defs>
			<path id={id} d="M100,100 m-82,0 a82,82 0 1,1 164,0 a82,82 0 1,1 -164,0"></path>
		</defs>
		<text>
			<textPath href={`#${id}`} textLength="510">{text}</textPath>
		</text>
	</svg>
	<svg viewBox="0 0 200 200" class="badge__core">
		<circle cx="100" cy="100" r="64" fill="none" stroke="currentColor" stroke-width="2.2"></circle>
		<line x1="116" y1="62" x2="84" y2="138" stroke="currentColor" stroke-width="2.2"></line>
		<!-- Stacked either side of the slash, like the logo, so both words sit well inside the ring. -->
		<text x="97" y="97" text-anchor="end">Serranos</text>
		<text x="104" y="116" text-anchor="start">cafe</text>
	</svg>
</span>

<style>
	.badge {
		position: relative;
		display: inline-block;
		width: 9rem;
		aspect-ratio: 1;
		color: currentColor;
	}

	.badge svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.badge__ring {
		animation: badge-spin 22s linear infinite;
	}

	.badge__ring text {
		font-family: var(--font-mono);
		font-size: 13px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		fill: currentColor;
	}

	.badge__core text {
		font-family: var(--font-display);
		font-size: 10.5px;
		fill: currentColor;
	}

	@keyframes badge-spin {
		to {
			transform: rotate(360deg);
		}
	}
</style>
