---
/**
 * First-visit intro: the slash draws, the two words slide out from behind it,
 * then the curtain is cut away along the same angle. Pure CSS so it can never
 * get stuck, and skipped on repeat visits and for reduced motion.
 */
---

<div class="loader" aria-hidden="true">
	<div class="loader__mark">
		<span class="loader__side loader__side--l"><span>serranos</span></span>
		<span class="loader__slash"></span>
		<span class="loader__side loader__side--r"><span>cafe</span></span>
	</div>
	<div class="loader__meta mono">
		<span>Tarneit Gardens</span>
		<span>100% Halal</span>
	</div>
</div>

<style>
	.loader {
		display: none;
	}

	:global(.show-loader) .loader {
		position: fixed;
		inset: 0;
		z-index: 1000;
		display: grid;
		place-items: center;
		background: var(--ink);
		color: var(--paper);
		pointer-events: none;
		clip-path: polygon(0% 0, 140% 0, 140% 100%, -40% 100%);
		animation: loader-cut 0.85s var(--ease-io) 1.05s forwards;
	}

	.loader__mark {
		display: flex;
		align-items: center;
		gap: 0.22em;
		font-family: var(--font-display);
		font-size: clamp(2.6rem, 9vw, 7.5rem);
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.loader__side {
		display: block;
		overflow: clip;
		/* Room either side so the outer letters' overhang isn't trimmed by the mask. */
		padding: 0.05em 0.12em 0.12em;
	}

	.loader__side > span {
		display: block;
		animation: loader-in 0.9s var(--ease-out) 0.35s both;
	}

	.loader__side--l > span {
		--from: 115%;
	}

	.loader__side--r > span {
		--from: -115%;
	}

	.loader__slash {
		width: max(2px, 0.045em);
		height: 1.7em;
		background: currentColor;
		transform: rotate(var(--slash)) scaleY(0);
		animation: loader-slash 0.6s var(--ease-out) 0.05s forwards;
	}

	.loader__meta {
		position: absolute;
		inset: auto var(--gutter) max(24px, env(safe-area-inset-bottom));
		display: flex;
		justify-content: space-between;
		font-size: var(--step--1);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		opacity: 0;
		animation: loader-fade 0.6s ease 0.5s forwards;
	}

	@keyframes loader-slash {
		to {
			transform: rotate(var(--slash)) scaleY(1);
		}
	}

	@keyframes loader-in {
		from {
			transform: translateX(var(--from));
		}
		to {
			transform: none;
		}
	}

	@keyframes loader-fade {
		to {
			opacity: 0.6;
		}
	}

	@keyframes loader-cut {
		to {
			clip-path: polygon(140% 0, 140% 0, 140% 100%, 100% 100%);
			visibility: hidden;
		}
	}
</style>
