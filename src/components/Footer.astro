---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site, formatTime } from '../data/site';
import { photos, type PhotoKey } from '../data/photos';

const feed: PhotoKey[] = ['smoothies', 'smashedAvo', 'oatMapleLatte', 'biscoffHotcakes', 'bananaIcedChoc'];
const year = new Date().getFullYear();
const weekday = site.hours[0];
const sat = site.hours[5];
const sun = site.hours[6];
---

<footer class="footer theme-ink" aria-labelledby="footer-title">
	<div class="wrap footer__social">
		<div class="footer__social-head">
			<p class="eyebrow footer__eyebrow">(06) Follow along</p>
			<a class="footer__handle serif" href={site.links.instagram} target="_blank" rel="noopener" data-cursor="Follow">
				{site.links.instagramHandle}
			</a>
		</div>
		<ul class="footer__feed">
			{
				feed.map((key, i) => (
					<li style={`--i:${i}`}>
						<a href={site.links.instagram} target="_blank" rel="noopener" data-cursor="Follow">
							<Image
								src={photos[key].src}
								alt={photos[key].alt}
								width={360}
								height={360}
								widths={[240, 360, 480]}
								sizes="(max-width: 860px) 31vw, 18vw"
								fit="cover"
								style={`object-position:${photos[key].focus}`}
							/>
						</a>
					</li>
				))
			}
		</ul>
	</div>

	<div class="wrap footer__cols">
		<div>
			<h2 class="mono footer__label" id="footer-title">Visit</h2>
			<p>
				{site.address.street}<br />
				{site.address.centre}<br />
				{site.address.suburb} {site.address.state} {site.address.postcode}
			</p>
		</div>
		<div>
			<h3 class="mono footer__label">Hours</h3>
			<p>
				Mon–Fri {formatTime(weekday.open)}–{formatTime(weekday.close)}<br />
				Sat {formatTime(sat.open)}–{formatTime(sat.close)}<br />
				Sun {formatTime(sun.open)}–{formatTime(sun.close)}
			</p>
		</div>
		<div>
			<h3 class="mono footer__label">Order</h3>
			<ul class="footer__links">
				<li><a href={site.links.uberEats} target="_blank" rel="noopener">Uber Eats <Icon name="arrow" /></a></li>
				{site.links.doorDash && <li><a href={site.links.doorDash} target="_blank" rel="noopener">DoorDash <Icon name="arrow" /></a></li>}
				<li><a href={site.phone.href}>{site.phone.display}</a></li>
			</ul>
		</div>
		<div>
			<h3 class="mono footer__label">Social</h3>
			<ul class="footer__links">
				<li><a href={site.links.instagram} target="_blank" rel="noopener"><Icon name="instagram" /> Instagram</a></li>
				<li><a href={site.links.facebook} target="_blank" rel="noopener"><Icon name="facebook" /> Facebook</a></li>
			</ul>
		</div>
	</div>

	<div class="footer__mark" aria-hidden="true" data-footer-mark>
		<span class="footer__word">serranos</span>
		<span class="footer__slash"></span>
		<span class="footer__word">cafe</span>
	</div>

	<div class="wrap footer__base mono">
		<span>© {year} {site.name}</span>
		<span>100% Halal · Tarneit, Victoria</span>
		<a href="#top" class="footer__top">Back to top ↑</a>
		{site.credit && <span>Site by {site.credit}</span>}
	</div>
</footer>

<style>
	.footer {
		position: relative;
		overflow: hidden;
		padding-top: clamp(80px, 10vw, 140px);
		padding-bottom: max(24px, env(safe-area-inset-bottom));
	}

	.footer__social {
		display: grid;
		gap: 32px;
	}

	.footer__social-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: end;
		gap: 16px;
	}

	.footer__eyebrow {
		color: color-mix(in oklab, var(--paper) 60%, transparent);
	}

	.footer__handle {
		font-size: var(--step-3);
		line-height: 1;
		letter-spacing: -0.02em;
		background: linear-gradient(currentColor, currentColor) 0 100% / 0 1.5px no-repeat;
		transition: background-size 0.6s var(--ease-out);
	}

	.footer__handle:hover {
		background-size: 100% 1.5px;
	}

	.footer__feed {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 12px;
	}

	.footer__feed li {
		overflow: hidden;
		aspect-ratio: 1;
	}

	.footer__feed li:nth-child(even) {
		transform: translateY(24px);
	}

	.footer__feed :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(0.85) contrast(1.05);
		transition:
			filter 0.6s var(--ease-out),
			scale 0.9s var(--ease-out);
	}

	.footer__feed a:hover :global(img),
	.footer__feed a:focus-visible :global(img) {
		filter: none;
		scale: 1.06;
	}

	.footer__cols {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 32px 24px;
		margin-top: clamp(80px, 10vw, 140px);
		padding-top: 32px;
		border-top: 1px solid var(--line);
		color: color-mix(in oklab, var(--paper) 78%, transparent);
	}

	.footer__label {
		margin-bottom: 14px;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		line-height: 1.3;
		color: var(--timber-2);
	}

	.footer__links {
		display: grid;
		gap: 6px;
	}

	.footer__links a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		transition: color 0.3s;
	}

	.footer__links a:hover {
		color: var(--paper);
	}

	.footer__mark {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.16em;
		margin-top: clamp(48px, 8vw, 120px);
		font-family: var(--font-display);
		font-size: 15vw;
		line-height: 0.8;
		letter-spacing: -0.05em;
		white-space: nowrap;
		color: var(--paper);
		user-select: none;
	}

	.footer__word {
		display: inline-block;
		padding-bottom: 0.1em;
	}

	.footer__slash {
		flex: none;
		width: max(2px, 0.022em);
		height: 1.05em;
		background: var(--timber-2);
		transform: rotate(var(--slash));
	}

	.footer__base {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 10px 24px;
		padding-top: 20px;
		border-top: 1px solid var(--line);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: color-mix(in oklab, var(--paper) 55%, transparent);
	}

	.footer__top:hover {
		color: var(--paper);
	}

	@media (max-width: 860px) {
		.footer__feed {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.footer__feed li:nth-child(n + 4) {
			display: none;
		}

		.footer__cols {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.footer {
			padding-bottom: calc(96px + env(safe-area-inset-bottom));
		}
	}
</style>
