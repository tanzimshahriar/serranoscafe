---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Badge from './Badge.astro';
import { photos } from '../data/photos';
import { site } from '../data/site';

const hero = photos.biscoffHotcakes;

// The wordmark is drawn twice: ink on the paper side, paper on the photo side.
// The photo's diagonal clip slices the second copy, so letters change colour exactly on the cut.
---

<section class="hero" data-hero aria-labelledby="hero-title">
	<div class="hero__meta wrap mono" data-hero-fade>
		<span>Tarneit Gardens, VIC</span>
		<span class="hero__meta-sep" aria-hidden="true"></span>
		<span>100% Halal</span>
	</div>

	<h1 class="hero__title wrap" id="hero-title">
		<span class="hero__line"><span class="hero__word" data-hero-word>serranos</span></span>
		<span class="hero__line hero__line--2"><span class="hero__word" data-hero-word>cafe</span></span>
		<span class="sr-only"> — 100% halal brunch and specialty coffee in Tarneit, Melbourne</span>
	</h1>

	<div class="hero__media" data-hero-media>
		<div class="hero__img" data-hero-img>
			<Picture
				src={hero.src}
				alt={hero.alt}
				widths={[640, 960, 1280, 1600, 2000]}
				sizes="(max-width: 860px) 100vw, 90vw"
				formats={['avif', 'webp']}
				loading="eager"
				fetchpriority="high"
				style={`object-position:${hero.focus}`}
			/>
		</div>
		<div class="hero__title hero__title--ghost wrap" aria-hidden="true">
			<span class="hero__line"><span class="hero__word" data-hero-word>serranos</span></span>
			<span class="hero__line hero__line--2"><span class="hero__word" data-hero-word>cafe</span></span>
		</div>
		<p class="hero__caption mono" data-hero-fade>
			<span>Fig. 01</span>
			<span>Biscoff hotcakes, berries, vanilla ice cream — $25</span>
		</p>
	</div>

	<span class="hero__edge" aria-hidden="true" data-hero-edge></span>

	<div class="hero__foot wrap">
		<div class="hero__copy" data-hero-fade>
			<p class="hero__lede serif">Brunch,<br /> a cut above.</p>
			<p class="hero__text">
				A 100% halal cafe inside Tarneit Gardens. Slow-cooked brisket, sujuk shakshuka, Biscoff everything and coffee
				worth the detour.
			</p>
		</div>
		<div class="hero__ctas" data-hero-fade>
			<a class="btn" href={site.links.uberEats} target="_blank" rel="noopener" data-magnetic data-cursor="Order">
				Order online <Icon name="arrow" />
			</a>
			<a class="btn btn--ghost" href="#menu" data-magnetic>
				See the menu <Icon name="arrow-down" />
			</a>
		</div>
		<p class="hero__status mono" data-hero-fade>
			<span class="dot" data-open-dot></span>
			<span data-open-label>Open 7 days</span>
			<span class="hero__rating">★ {site.rating.value} · {site.rating.count} ratings on {site.rating.source}</span>
		</p>
	</div>

	<Badge class="hero__badge" />
</section>

<style>
	/* The cut is a plain number (percent of hero width) so it can drive both the
	   clip-path (as %) and transforms (as cqw) — transforms keep the intro off the layout path. */
	@property --cut-in {
		syntax: '<number>';
		inherits: true;
		initial-value: 63;
	}

	.hero {
		--h: max(100svh, 680px);
		--off: calc(var(--h) * 0.4663);
		--cut-scroll: 0;
		--c: calc(var(--cut-in) - var(--cut-scroll));
		--cut: calc(var(--c) * 1%);
		--cut-x: calc(var(--c) * 1cqw);
		--d: 0.15s;
		container-type: inline-size;
		position: relative;
		height: var(--h);
		overflow: clip;
		isolation: isolate;
		animation: hero-cut 1.6s var(--ease-out) var(--d) both;
	}

	:global(.show-loader) .hero {
		--d: 1.2s;
	}

	/* --------------------------------------------- intro, all in CSS */

	@keyframes hero-cut {
		from {
			--cut-in: 118;
		}
	}

	@keyframes hero-rise {
		from {
			transform: translateY(110%);
		}
	}

	@keyframes hero-fade {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
	}

	@keyframes hero-zoom {
		from {
			transform: scale(1.3);
		}
	}

	@keyframes hero-draw {
		from {
			transform: translateX(-14px) rotate(var(--slash)) scaleY(0);
		}
	}

	@keyframes hero-spin-in {
		from {
			transform: scale(0) rotate(-90deg);
		}
	}

	.hero__word {
		animation: hero-rise 1.4s var(--ease-out) calc(var(--d) + 0.1s) both;
	}

	.hero__line--2 .hero__word {
		animation-delay: calc(var(--d) + 0.2s);
	}

	[data-hero-fade] {
		animation: hero-fade 1.1s var(--ease-out) calc(var(--d) + 0.5s) both;
	}

	.hero__ctas[data-hero-fade] {
		animation-delay: calc(var(--d) + 0.6s);
	}

	.hero__status[data-hero-fade] {
		animation-delay: calc(var(--d) + 0.7s);
	}

	.hero__img :global(picture) {
		animation: hero-zoom 2.2s var(--ease-out) var(--d) both;
	}

	.hero__meta {
		position: absolute;
		top: clamp(84px, 11vh, 120px);
		left: 0;
		display: flex;
		align-items: center;
		gap: 14px;
		font-size: var(--step--1);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.hero__meta-sep {
		width: 1px;
		height: 16px;
		background: currentColor;
		transform: rotate(var(--slash));
	}

	.hero__title {
		position: absolute;
		top: calc(clamp(84px, 11vh, 120px) + 3.2rem);
		left: 0;
		z-index: 1;
		display: block;
		/* Set here, not inherited: the ghost copy is a div, and both copies must share one face to line up on the cut. */
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(5rem, min(15.2vw, 24svh), 18rem);
		line-height: 0.86;
		letter-spacing: -0.045em;
		pointer-events: none;
	}

	/* Clip only the bottom (where the words rise from), so the last letter's overhang survives. */
	.hero__line {
		display: block;
		clip-path: inset(-0.5em -0.3em 0 -0.3em);
		padding-bottom: 0.1em;
	}

	.hero__line--2 {
		padding-left: 1.35em;
	}

	.hero__word {
		display: inline-block;
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 2;
		background: var(--ink);
		color: var(--paper);
		clip-path: polygon(var(--cut) 0, 100% 0, 100% 100%, calc(var(--cut) - var(--off)) 100%);
	}

	.hero__img {
		position: absolute;
		inset: 0 0 0 10%;
		overflow: hidden;
	}

	/* A shadow that hugs the cut, so the paper-coloured letters stay legible over the photo. */
	.hero__media::before {
		content: '';
		position: absolute;
		z-index: 1;
		top: -12%;
		bottom: -12%;
		left: 0;
		translate: calc(var(--cut-x) - var(--off) / 2) 0;
		width: 38vw;
		background: linear-gradient(90deg, rgb(20 17 14 / 0.66), rgb(20 17 14 / 0.28) 45%, transparent);
		-webkit-mask-image: linear-gradient(180deg, #000 30%, transparent 72%);
		mask-image: linear-gradient(180deg, #000 30%, transparent 72%);
		transform: rotate(var(--slash));
		transform-origin: 0 50%;
		pointer-events: none;
	}

	.hero__title--ghost {
		z-index: 2;
	}

	.hero__caption {
		z-index: 2;
	}

	.hero__img :global(picture),
	.hero__img :global(img) {
		width: 100%;
		height: 100%;
	}

	.hero__img :global(img) {
		object-fit: cover;
	}

	.hero__img::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgb(20 17 14 / 0.35), transparent 30%),
			linear-gradient(0deg, rgb(20 17 14 / 0.55), transparent 32%);
	}

	.hero__caption {
		position: absolute;
		right: var(--gutter);
		bottom: clamp(24px, 5vh, 48px);
		display: grid;
		gap: 4px;
		max-width: 22ch;
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-align: right;
		color: color-mix(in oklab, var(--paper) 82%, transparent);
	}

	.hero__edge {
		position: absolute;
		top: -6%;
		bottom: -6%;
		left: 0;
		translate: calc(var(--cut-x) - var(--off) / 2) 0;
		z-index: 3;
		width: 1.5px;
		background: var(--ink);
		transform: translateX(-14px) rotate(var(--slash));
		transform-origin: 50% 50%;
		pointer-events: none;
		animation: hero-draw 1.4s var(--ease-io) calc(var(--d) + 0.3s) both;
	}

	.hero__foot {
		position: absolute;
		left: 0;
		bottom: clamp(28px, 6vh, 56px);
		z-index: 4;
		display: grid;
		gap: 22px;
		width: min(100%, calc(63% - var(--off) - 24px));
		min-width: 0;
	}

	.hero__copy {
		display: grid;
		gap: 10px;
		max-width: 30rem;
	}

	.hero__lede {
		font-size: var(--step-2);
		line-height: 1.05;
	}

	.hero__text {
		color: var(--muted);
		max-width: 34ch;
	}

	.hero__ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.hero__status {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 10px;
		font-size: 0.76rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.hero__rating {
		flex-basis: 100%;
		padding-left: 18px;
		color: var(--muted);
	}

	.hero :global(.hero__badge) {
		position: absolute;
		z-index: 4;
		top: 78%;
		left: 0;
		width: clamp(8.5rem, 10.5vw, 11rem);
		translate: calc(var(--cut-x) - var(--off) * 0.78 - 50%) -50%;
		/* A solid stamp straddling the cut, so it reads over paper and photo alike. */
		color: var(--ink);
		background: var(--timber-2);
		border-radius: 50%;
		box-shadow:
			0 0 0 1.5px var(--ink),
			0 22px 44px -20px rgb(20 17 14 / 0.7);
		animation: hero-spin-in 1.4s var(--ease-out) calc(var(--d) + 0.7s) both;
	}

	/* Short laptop screens: keep the wordmark and the actions, lose the paragraph. */
	@media (min-width: 861px) and (max-height: 780px) {
		.hero__text {
			display: none;
		}
	}

	@media (max-width: 860px) {
		.hero {
			--h: auto;
			height: auto;
			display: flex;
			flex-direction: column;
			padding-top: 84px;
			padding-bottom: 112px;
		}

		.hero__meta,
		.hero__title,
		.hero__foot {
			position: relative;
			inset: auto;
		}

		.hero__meta {
			order: 1;
		}

		.hero__title {
			order: 2;
			margin-top: 18px;
			font-size: clamp(3.6rem, 21.5vw, 9rem);
		}

		.hero__line--2 {
			padding-left: 0;
			text-align: right;
		}

		.hero__media {
			order: 3;
			position: relative;
			inset: auto;
			height: min(118vw, 560px);
			margin: 10px var(--gutter) 0;
			clip-path: polygon(16% 0, 100% 0, 84% 100%, 0 100%);
			animation: hero-cut-mobile 1.3s var(--ease-io) calc(var(--d) + 0.2s) both;
		}

		@keyframes hero-cut-mobile {
			from {
				clip-path: polygon(16% 0, 16% 0, 0 100%, 0 100%);
			}
		}

		.hero__img {
			inset: 0;
		}

		.hero__title--ghost,
		.hero__edge,
		.hero__media::before {
			display: none;
		}

		.hero__caption {
			right: 20%;
			bottom: 18px;
		}

		.hero__foot {
			order: 4;
			width: 100%;
			margin-top: 28px;
		}

		.hero :global(.hero__badge) {
			top: auto;
			left: auto;
			right: var(--gutter);
			display: none;
		}
	}
</style>
