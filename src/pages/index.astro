---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Manifesto from '../components/Manifesto.astro';
import Cut from '../components/Cut.astro';
import Signatures from '../components/Signatures.astro';
import Reviews from '../components/Reviews.astro';
import Explore from '../components/Explore.astro';
import Order from '../components/Order.astro';
import Visit from '../components/Visit.astro';
import { site } from '../data/site';
---

<Layout>
	<Hero />
	<Marquee
		items={['100% Halal', 'Slow-cooked brisket', 'Biscoff · Nutella · Pistachio', 'Specialty coffee', 'Smoothie season', 'Tarneit Gardens']}
	/>
	<Manifesto />
	<Cut />
	<Signatures />
	<Reviews num="03" more />
	<Explore num="04" />
	<Marquee tone="timber" tilt={1.8} reverse items={['Dine in', 'Pick up', 'Delivered', 'Open 7 days', `Call ${site.phone.display}`]} />
	<Order />
	<Visit />
</Layout>
